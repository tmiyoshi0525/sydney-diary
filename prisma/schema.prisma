// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Post {
  id      String   @id @default(uuid())
  title   String
  content String
  image   String
  date    String
  likes   Int      @default(0)
  createdAt DateTime @default(now())
}
